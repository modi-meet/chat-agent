# the only key you need. chat, web search and the ledger all go through it.
# get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# optional
# PORT=8002
# gemini-2.5-flash is the one model where Google Search is free.
# on a paid key use gemini-3.8-flash: better, but search needs billing there.
CHAT_MODEL=gemini-2.5-flash
LEDGER_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL=low
